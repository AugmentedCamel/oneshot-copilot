<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>amicooked? - Dashboard</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <!-- Settings Button -->
    <button class="settings-btn" id="settingsBtn" aria-label="Settings">⚙️</button>

    <!-- Settings Backdrop -->
    <div class="settings-backdrop" id="settingsBackdrop"></div>

    <!-- Settings Overlay -->
    <div class="settings-overlay" id="settingsOverlay">
        <div class="settings-header">
            <h2>Settings</h2>
        </div>
        <div class="settings-content">
            <div class="setting-item">
                <div>
                    <div class="setting-label">Text-to-Speech (TTS)</div>
                    <div class="toggle-status" id="ttsStatus">Loading...</div>
                </div>
                <label class="toggle-switch">
                    <input type="checkbox" id="ttsToggle">
                    <span class="slider"></span>
                </label>
            </div>
        </div>
    </div>

    <div class="container">
        <header>
            <h1>amicooked?</h1>
            <% if (userId) { %>
                <p class="user-info">Welcome, <span id="username">loading...</span></p>
                <% } %>
        </header>

        <div class="instructions">
            <% if (userId) { %>
                <p>User ID: <span class="user-id">
                        <%= userId %>
                    </span></p>
                <p>You're logged in and ready to start cooking! 🔥</p>
                <% } else { %>
                    <p>Not logged in</p>
                    <% } %>
        </div>

        <div class="content">
            <h2>Select a Procedure</h2>
            <div class="procedure-list" id="procedureList">
                <div class="procedure-item selected" data-procedure="dishwasher_salt_replacement@v1">
                    <span class="procedure-name">Dishwasher maintenance</span>
                </div>
            </div>
        </div>

        <div class="button-container">
            <button class="start-stream-btn" id="startStreamBtn">Start Stream</button>
        </div>
    </div>

    <script>
        // Settings overlay functionality
        const settingsBtn = document.getElementById('settingsBtn');
        const settingsOverlay = document.getElementById('settingsOverlay');
        const settingsBackdrop = document.getElementById('settingsBackdrop');
        const ttsToggle = document.getElementById('ttsToggle');
        const ttsStatus = document.getElementById('ttsStatus');

        function toggleSettings() {
            const isOpen = settingsOverlay.classList.contains('open');
            if (isOpen) {
                closeSettingsPanel();
            } else {
                openSettings();
            }
        }

        function openSettings() {
            settingsOverlay.classList.add('open');
            settingsBackdrop.classList.add('open');
            settingsBtn.classList.add('active');
        }

        function closeSettingsPanel() {
            settingsOverlay.classList.remove('open');
            settingsBackdrop.classList.remove('open');
            settingsBtn.classList.remove('active');
        }

        settingsBtn.addEventListener('click', toggleSettings);
        settingsBackdrop.addEventListener('click', closeSettingsPanel);

        // Update TTS status text
        function updateTTSStatus(enabled) {
            ttsStatus.textContent = enabled ? 'Enabled' : 'Disabled';
            ttsStatus.style.color = enabled ? 'var(--success-color)' : 'var(--secondary-color)';
        }

        // Fetch the user's login name
        async function fetchUsername() {
            try {
                const response = await fetch('/api/get-login-name');
                const data = await response.json();

                if (data.success && data.name) {
                    document.getElementById('username').textContent = data.name;
                }
            } catch (error) {
                console.error('Error fetching username:', error);
            }
        }

        // Load user settings
        async function loadUserSettings() {
            try {
                const response = await fetch('/api/user-settings');
                const data = await response.json();

                if (data.success && data.settings) {
                    // Default to enabled (true) if not set
                    ttsToggle.checked = data.settings.ttsEnabled !== false;
                    updateTTSStatus(ttsToggle.checked);
                } else {
                    // Default to enabled
                    ttsToggle.checked = true;
                    updateTTSStatus(true);
                }
            } catch (error) {
                console.error('Error loading user settings:', error);
                // Default to enabled
                ttsToggle.checked = true;
                updateTTSStatus(true);
            }
        }

        // Save user settings
        async function saveUserSettings(settings) {
            try {
                const response = await fetch('/api/user-settings', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify(settings),
                });
                const data = await response.json();

                if (!data.success) {
                    console.error('Failed to save settings:', data.error);
                }
            } catch (error) {
                console.error('Error saving user settings:', error);
            }
        }

        // Handle TTS toggle change
        ttsToggle.addEventListener('change', async function () {
            const enabled = this.checked;
            updateTTSStatus(enabled);
            await saveUserSettings({ ttsEnabled: enabled });
        });

        // Procedure selection functionality
        const procedureList = document.getElementById('procedureList');
        const startStreamBtn = document.getElementById('startStreamBtn');
        let selectedProcedure = 'dishwasher_salt_replacement@v1'; // Default selection

        // Handle procedure item clicks
        if (procedureList) {
            procedureList.addEventListener('click', function (e) {
                const procedureItem = e.target.closest('.procedure-item');
                if (procedureItem) {
                    // Remove 'selected' class from all items
                    document.querySelectorAll('.procedure-item').forEach(item => {
                        item.classList.remove('selected');
                    });
                    // Add 'selected' class to clicked item
                    procedureItem.classList.add('selected');
                    // Update selected procedure
                    selectedProcedure = procedureItem.dataset.procedure;
                }
            });
        }

        // Handle start stream button click
        if (startStreamBtn) {
            startStreamBtn.addEventListener('click', async function () {
                try {
                    // Call the start-stream API to set user state to WORKING and trigger TTS
                    const response = await fetch('/api/start-stream', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                        },
                        body: JSON.stringify({ procedure: selectedProcedure }),
                    });

                    const data = await response.json();

                    if (data.success) {
                        // Navigate to taskview with selected procedure
                        window.location.href = `/taskview?procedure=${encodeURIComponent(selectedProcedure)}`;
                    } else {
                        console.error('Failed to start stream:', data.error);
                        alert('Failed to start stream: ' + data.error);
                    }
                } catch (error) {
                    console.error('Error starting stream:', error);
                    alert('Error starting stream. Please try again.');
                }
            });
        }

    // Load username and settings when page loads
    <% if (userId) { %>
            fetchUsername();
            loadUserSettings();
    <% } %>
    </script>
</body>

</html>