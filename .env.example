# Oneshot Copilot Configuration

# Your server's public URL (for VLM callbacks)
# Use http:// for localhost, https:// for ngrok or production domains
SELF_URL=http://localhost:8000

# Client webhook URL (for sending progress updates)
MENTRA_URL=https://client-webhook.example.com

# VLM Provider Configuration
# Options: "local", "moondream", "auki_local"
VLM_PROVIDER=auki_local

# VLM service URL (used by: local, auki_local providers)
VLM_URL=http://localhost:8080

# Moondream AI API key (used by: moondream provider)
# API docs: https://docs.moondream.ai/api
MOONDREAM_API_KEY=your_moondream_api_key_here

# Maximum number of frames to buffer per user
MAX_FRAMES_PER_USER=1

# RTSP/RTMP Stream Configuration (Optional)
# Leave empty to disable automatic stream ingestion
# Supported protocols: rtsp://, rtmp://
# Example RTSP: rtsp://192.168.2.7:8554/live/oneshot
# Example RTMP: rtmp://localhost:1935/live/stream
RTSP_STREAM_URL=rtsp://192.168.2.7:8554/live/oneshot

# Stream Protocol (for logging - auto-detected from URL prefix)
STREAM_PROTOCOL=rtsp

# Username to use for frames ingested from the stream
STREAM_USERNAME=Mikameel

# Frame Storage Configuration (Optional)
# Set to True to save all ingested frames to disk for debugging/verification
# Frames will be saved to app/data/frames/ with their frame_id as filename
# This helps verify that frames are not being reused
# SAVE_FRAMES_TO_DISK=False

# Data Harvester Configuration (Optional)
# Enable harvester mode at startup to capture labeled frames for LoRA training
# Use API endpoints to toggle: POST /api/v2/harvester/start, /stop
DATA_HARVESTER_ENABLED=false
DATA_HARVESTER_BASE_DIR=data_lake/proc_refill_dishwasher/auto_labeled