# Oneshot Copilot Configuration

# Your server's public URL (for VLM callbacks)
# Use http:// for localhost, https:// for ngrok or production domains
SELF_URL=http://localhost:8000

# Client webhook URL (for sending progress updates)
MENTRA_URL=https://client-webhook.example.com

# VLM service URL (for sending frame analysis requests)
VLM_URL=http://localhost:8080

# Maximum number of frames to buffer per user
MAX_FRAMES_PER_USER=1

# RTSP/RTMP Stream Configuration (Optional)
# Leave empty to disable automatic stream ingestion
# Example: rtsp://192.168.1.100:8554/live/stream
RTSP_STREAM_URL=rtmp://localhost:8554/live/stream

# Username to use for frames ingested from the RTSP stream
STREAM_USERNAME=Mikameel

# Frame Storage Configuration (Optional)
# Set to True to save all ingested frames to disk for debugging/verification
# Frames will be saved to app/data/frames/ with their frame_id as filename
# This helps verify that frames are not being reused
# SAVE_FRAMES_TO_DISK=False