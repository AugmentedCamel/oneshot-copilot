{
  "id": "pizza_custom@v1",
  "name": "Make a Custom Pizza",
  "version": 1,
  "steps": [
    {
      "id": 1,
      "name": "Show pizza dough pls",
      "positives": [
        "A plain and empty pizza base or dough is clearly visible. Only answer with [yes] or [no]"
      ],
      "timeout_s": 200,
      "debounce": {
        "consecutive_yes": 3
      },
      "step_context": {
        "step_id": "show_pizza_dough",
        "instruction": "Present a plain pizza dough",
        "council": {
          "members": [
            {
              "role": "state_analyst",
              "prompt": "Is there a plain pizza dough visible?",
              "attention": "PRIMARY",
              "weight": 0.9
            },
            {
              "role": "quality_inspector",
              "prompt": "Is the dough properly shaped and ready for toppings?",
              "attention": "SECONDARY",
              "weight": 0.4
            }
          ],
          "reasoning_rules": {
            "complete": "state_analyst == 'Yes'"
          }
        }
      }
    },
    {
      "id": 2,
      "name": "Add salami",
      "positives": [
        "Slices of salami are evenly distributed on the pizza. Only answer with [yes] or [no]"
      ],
      "timeout_s": 200,
      "debounce": {
        "consecutive_yes": 4
      },
      "step_context": {
        "step_id": "add_salami",
        "instruction": "Add salami slices evenly on the pizza",
        "council": {
          "members": [
            {
              "role": "state_analyst",
              "prompt": "Are salami slices visible on the pizza?",
              "attention": "PRIMARY",
              "weight": 0.9
            },
            {
              "role": "distribution_checker",
              "prompt": "Are the salami slices evenly distributed?",
              "attention": "PRIMARY",
              "weight": 0.7
            }
          ],
          "reasoning_rules": {
            "complete": "state_analyst == 'Yes' AND distribution_checker == 'Yes'"
          }
        }
      }
    },
    {
      "id": 3,
      "name": "Add mushrooms",
      "positives": [
        "Do you see sliced mushrooms spread evenly across the pizza base, covering a large part of it. Only answer with [yes] or [no]"
      ],
      "bounding_questions": [
        "mushrooms"
      ],
      "rules": [
        {
          "type": "cluster_negative",
          "name": "Prevent Mushroom Clustering",
          "description": "Ensures mushrooms are not clustered together in groups",
          "enabled": true,
          "failure_behavior": "block",
          "parameters": {
            "target": "mushrooms",
            "max_cluster_size": 3,
            "min_distance": 50
          }
        }
      ],
      "timeout_s": 200,
      "debounce": {
        "consecutive_yes": 3
      },
      "debug": true,
      "step_context": {
        "step_id": "add_mushrooms",
        "instruction": "Add sliced mushrooms evenly across the pizza",
        "council": {
          "members": [
            {
              "role": "state_analyst",
              "prompt": "Are mushroom slices visible on the pizza?",
              "attention": "PRIMARY",
              "weight": 0.9
            },
            {
              "role": "distribution_checker",
              "prompt": "Are the mushrooms spread evenly without clustering?",
              "attention": "CRITICAL",
              "weight": 0.8
            },
            {
              "role": "coverage_analyst",
              "prompt": "Do the mushrooms cover a large part of the pizza?",
              "attention": "SECONDARY",
              "weight": 0.5
            }
          ],
          "reasoning_rules": {
            "complete": "state_analyst == 'Yes' AND distribution_checker == 'Yes'"
          }
        }
      }
    },
    {
      "id": 4,
      "name": "Add basil",
      "positives": [
        "Do you see at least multiple green basil leaves are clearly visible on top of the pizza. Only answer with [yes] or [no]"
      ],
      "timeout_s": 200,
      "debounce": {
        "consecutive_yes": 3
      },
      "step_context": {
        "step_id": "add_basil",
        "instruction": "Add multiple green basil leaves on top",
        "council": {
          "members": [
            {
              "role": "state_analyst",
              "prompt": "Are green basil leaves visible on the pizza?",
              "attention": "PRIMARY",
              "weight": 0.9
            },
            {
              "role": "quantity_checker",
              "prompt": "Are there multiple basil leaves (more than one)?",
              "attention": "PRIMARY",
              "weight": 0.7
            }
          ],
          "reasoning_rules": {
            "complete": "state_analyst == 'Yes' AND quantity_checker == 'Yes'"
          }
        }
      }
    }
  ]
}